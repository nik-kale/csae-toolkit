{
  "manifest_version": 3,
  "name": "CSAE Toolkit",
  "description": "This extension complements the Cisco Support Assistant Extension (CSAE) and offers purpose-built tools to aid in campaign creation.",
  "version": "2.0.0",
  "permissions": ["activeTab", "scripting", "storage", "cookies", "clipboardWrite", "sidePanel"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Click to open panel",
    "default_icon": "icon128.png"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "grab-selector": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Toggle the CSS selector hover tool on the active tab"
    },
    "pick-color": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open the eyedropper to pick a color"
    },
    "view-config": {
      "description": "Open the CSAE config viewer on the active tab"
    }
  }
}
